<odoo>
    <data noupdate="1">
        <record id="ir_cron_simple_warehouse_sync" model="ir.cron">
            <field name="name">Simple Warehouse Sync</field>
            <field name="model_id" search="[('model', '=', 'simple.warehouse.sync')]"/>
            <field name="state">code</field>
            <field name="code">model.run_sync()</field>
            <!-- run once per day -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="active">True</field>
            <!-- nextcall time; you can adjust in UI to exact 10:00 in your timezone -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=10, minute=0, second=0, microsecond=0))"/>
        </record>
    </data>
</odoo>
